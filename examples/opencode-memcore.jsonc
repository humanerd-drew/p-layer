// opencode-memcore.jsonc
// Paste this `mcp` block into drewgent's opencode.jsonc (or your own) to
// replace the remember/recall tooling with the memcore MCP server.
// Then update AGENTS.md / .opencode/instructions so the agent uses the
// memcore tools (remember, recall, forget, update, snapshot_*, memory_stats,
// memory_audit, graph_*, assemble) instead of the template's.
{
  "mcp": {
    "memcore": {
      "type": "local",
      "command": ["python3", "-m", "memcore", "serve"],
      "env": {
        "MEMCORE_DB": "~/.memcore/memory.db",
        "MEMCORE_EMBED": "ollama"
      },
      "enabled": true
    }
  }
}
